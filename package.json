{
  "name": "clay-mcp",
  "version": "1.0.0",
  "description": "MCP server for Clay — 73 tools, 1,100+ enrichment providers. Maps Clay's internal API for full table, record, enrichment, and CRM control from Claude Code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clay-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp src/enrichments/registry.json dist/enrichments/ && mkdir -p dist/templates && cp src/templates/claygent-prompts.json dist/templates/",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "clay",
    "model-context-protocol",
    "enrichment",
    "gtm",
    "claude-code",
    "data-enrichment",
    "crm",
    "sales-automation",
    "api"
  ],
  "author": "Shane Firek <https://linkedin.com/in/shanefirek>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shanefirek/clay-mcp-public.git"
  },
  "homepage": "https://github.com/shanefirek/clay-mcp-public#readme",
  "bugs": {
    "url": "https://github.com/shanefirek/clay-mcp-public/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^17.2.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
