# Clay Session Cookie (required)
# Get this from Chrome DevTools > Application > Cookies > claysession
# Session cookies expire - refresh when API calls fail with 401
CLAY_SESSION_COOKIE=s%3Ayour_session_cookie_here

# Optional: Default table ID for testing
CLAY_TABLE_ID=t_your_table_id

# Optional: Workspace ID
CLAY_WORKSPACE_ID=your_workspace_id

# =============================================================================
# OPTIONAL: Override Clay-managed accounts with your own API keys
# =============================================================================
# By default, the MCP server uses Clay-managed accounts (Clay credits).
# Set these to use your own connected accounts instead.
#
# Format: CLAY_{PROVIDER}_ACCOUNT_ID=aa_xxx
# Find your account IDs with: npx ts-node scripts/discover-clay-accounts.ts

# Email Finders
# CLAY_HUNTER_ACCOUNT_ID=aa_your_hunter_account
# CLAY_FINDYMAIL_ACCOUNT_ID=aa_your_findymail_account
# CLAY_LEADMAGIC_ACCOUNT_ID=aa_your_leadmagic_account
# CLAY_PROSPEO_ACCOUNT_ID=aa_your_prospeo_account
# CLAY_DROPCONTACT_ACCOUNT_ID=aa_your_dropcontact_account
# CLAY_DATAGMA_ACCOUNT_ID=aa_your_datagma_account
# CLAY_ICYPEAS_ACCOUNT_ID=aa_your_icypeas_account
# CLAY_SMARTE_ACCOUNT_ID=aa_your_smarte_account

# CRM / Enrichment
# CLAY_APOLLO_OAUTH_ACCOUNT_ID=aa_your_apollo_account

# Technographics
# CLAY_BUILT_WITH_ACCOUNT_ID=aa_your_builtwith_account

# AI
# CLAY_GPT_3_ACCOUNT_ID=aa_your_openai_account
